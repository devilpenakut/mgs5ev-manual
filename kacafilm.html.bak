            <tr><td>VIP</td><td>15%</td><td>97%</td><td>73%</td><td>&gt;99%</td><td>Samping</td></tr>
            <tr><td>X15</td><td>17%</td><td>87%</td><td>69%</td><td>&gt;99%</td><td>Samping</td></tr>
            <tr><td>X05</td><td>6.5%</td><td>84%</td><td>71%</td><td>&gt;99%</td><td>Samping (super gelap)</td></tr>
