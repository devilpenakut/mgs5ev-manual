            <tr><td>VK40</td><td>43%</td><td class="accent-value">98%</td><td>65%</td><td>&gt;99%</td><td>Depan / Sunroof</td></tr>
            <tr><td>VK30</td><td>36%</td><td class="accent-value">98%</td><td class="accent-value">66%</td><td>&gt;99%</td><td>Depan / Sunroof</td></tr>
            <tr><td>VK10</td><td>13%</td><td class="accent-value">98%</td><td class="accent-value">74%</td><td>&gt;99%</td><td>Samping ⭐ TSER tertinggi</td></tr>
          </tbody>
        </table>
      </div>

      <h3>VIP &amp; X Series — Samping &amp; Belakang</h3>
      <div class="table-wrap" role="region" aria-label="Spesifikasi V-KOOL VIP dan X Series" tabindex="0">
        <table>
          <thead>
            <tr><th>Varian</th><th>VLT</th><th>IR</th><th>TSER</th><th>UVR</th><th>Cocok</th></tr>
          </thead>
