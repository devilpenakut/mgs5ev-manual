            <tr><td>CS 20</td><td>23%</td><td>72%</td><td>61%</td><td>99%</td><td>Samping</td></tr>
            <tr><td>CS 10</td><td>8%</td><td>92%</td><td class="accent-value">70%</td><td>99%</td><td>Samping (gelap)</td></tr>
