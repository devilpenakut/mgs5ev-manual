      <h3>3M Color Stable —Non-Metal ✅ (Entry Level)</h3>
      <div class="table-wrap" role="region" aria-label="Spesifikasi 3M Color Stable" tabindex="0">
        <table>
          <thead>
            <tr><th>Varian</th><th>TSER</th><th>UVR</th><th>Cocok</th></tr>
          </thead>
          <tbody>
