            <tr><td>OB 40</td><td>54%</td><td>31%</td><td>99%</td><td>Depan / Sunroof</td></tr>
            <tr><td>OB 35</td><td>45%</td><td>33%</td><td>99%</td><td>Sunroof</td></tr>
            <tr><td>OB 25</td><td>27%</td><td>38%</td><td>99%</td><td>Samping</td></tr>
            <tr><td>OB 15</td><td>19%</td><td>40%</td><td>99%</td><td>Samping</td></tr>
            <tr><td>OB 5</td><td>8%</td><td>44%</td><td>99%</td><td>Samping (gelap)</td></tr>
